# Interfaz web del cerebro (red/interfaz/servidor.ts). Muestra el nivel interno:
# va siempre detrás de usuario y contraseña (Security en Dokploy).
FROM oven/bun:1.3-alpine
WORKDIR /app
# Solo lo que usa la interfaz para redactar con Claude, si se configura ANTHROPIC_API_KEY.
RUN echo '{"name":"cerebro-interfaz","private":true,"dependencies":{"@anthropic-ai/sdk":"^1.3.0","zod":"^4.6.7"}}' > package.json && bun install --production
COPY red ./red
COPY public/brand/logo ./public/brand/logo
RUN mkdir -p red/registro && chown -R bun:bun /app/red/registro
ENV PORT=3100
EXPOSE 3100
USER bun
CMD ["bun", "red/interfaz/servidor.ts"]
